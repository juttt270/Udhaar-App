# MongoDB Connection String (Free MongoDB Atlas M0 Cluster or Local MongoDB)
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/water_plant_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/water_plant_db?retryWrites=true&w=majority

# JWT Encryption Secret for Secure Session Cookies (any random 32+ character string)
JWT_SECRET=udhaar_water_plant_super_secret_jwt_key_2026_xyz_secure_random_key_here

# Node Environment
NODE_ENV=production
